{
  "id": "com.dkts.keithley-4200-native-preview",
  "name": "DK Test Studio · DKDS Native TOP Preview",
  "version": "0.1.0",
  "apiVersion": "1.19.0",
  "entry": "plugin.js",
  "scripts": [
    "plugin.js"
  ],
  "platformPresentation": {
    "desktop": {
      "mode": "shared"
    },
    "mobile": {
      "mode": "adaptive"
    }
  },
  "enabled": true,
  "order": 83,
  "description": "Experimental host-native 4200A TOP workspace; no iframe or instrument output.",
  "pluginType": "workbench",
  "requiresCore": [
    "status",
    "events",
    "project",
    "state",
    "workspace",
    "data.sources",
    "data.artifacts",
    "ui.dom",
    "ui.workspace",
    "ui.unit-templates",
    "ui.scientific-plot",
    "ui.activities",
    "ui.top-workspace",
    "ui.pages"
  ],
  "capabilities": [
    "ui.page",
    "ui.top-workspace",
    "ui.plugin-workspace",
    "ui.scientific-plot",
    "data.scoped-sources",
    "state.store"
  ],
  "workspace": {
    "role": "top",
    "activity": "dkts-4200a-native",
    "icon": "▥",
    "title": "4200A 原生工作区"
  },
  "window": {
    "activity": "dkts-4200a-native",
    "title": "4200A 原生工作区",
    "width": 1380,
    "height": 840,
    "minWidth": 860,
    "minHeight": 570,
    "dependencies": [
      "scientific-renderer"
    ],
    "prewarm": false,
    "reuse": true,
    "persistence": "project",
    "artifactHydration": "live"
  },
  "data": {
    "accepts": [
      "science.transport.iv",
      "data.table"
    ]
  }
}
