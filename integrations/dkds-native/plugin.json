{
  "id": "com.dkts.keithley-4200",
  "name": "DK Test Studio - Keithley 4200A",
  "version": "0.8.26",
  "apiVersion": "1.19.0",
  "entry": "plugin.js",
  "scripts": [
    "hardware-capabilities.js",
    "kxci-protocol.js",
    "identity-core.js",
    "measurement-plan.js",
    "kxci-measurement.js",
    "model.js",
    "measurement-data.js",
    "measurement-runtime.js",
    "ui-shell.js",
    "plugin.js"
  ],
  "enabled": true,
  "order": 82,
  "description": "Native DKDS TOP workbench: FS-Pro scan editor, verified KXCI connection and guarded SMU execution; raw TI data is published to the DKDS Data Center.",
  "pluginType": "workbench",
  "requiresCore": [
    "status",
    "events",
    "workspace",
    "project",
    "state",
    "modules",
    "io",
    "data.model",
    "data.sources",
    "data.artifacts",
    "ui.workspace",
    "ui.dom",
    "ui.unit-templates",
    "ui.scientific-plot",
    "ui.table",
    "ui.activities",
    "ui.toolbar",
    "ui.context-menus",
    "ui.top-workspace",
    "ui.pages",
    "capabilities",
    "ui.settings",
    "ui.dialogs"
  ],
  "capabilities": [
    "ui.page",
    "ui.top-workspace",
    "ui.plugin-workspace",
    "ui.scientific-plot",
    "data.scoped-sources",
    "project.slice"
  ],
  "platformPresentation": {
    "desktop": {
      "mode": "shared"
    },
    "mobile": {
      "mode": "adaptive"
    }
  },
  "workspace": {
    "role": "top",
    "activity": "dkts-keithley-4200",
    "icon": "▦",
    "title": "4200A 测试",
    "defaultSuper": true
  },
  "window": {
    "activity": "dkts-keithley-4200",
    "title": "DK Test Studio 4200A",
    "width": 1380,
    "height": 860,
    "minWidth": 820,
    "minHeight": 560,
    "dependencies": [
      "scientific-renderer"
    ],
    "prewarm": false,
    "reuse": true,
    "persistence": "project",
    "artifactHydration": "live"
  },
  "data": {
    "accepts": [
      "science.transport.iv",
      "data.table"
    ]
  },
  "styles": [
    "ui-shell.css"
  ],
  "pluginDependencies": [
    {
      "id": "builtin.connectivity-center"
    }
  ]
}
