{
  "name": "dk-test-studio",
  "version": "0.2.7",
  "private": true,
  "description": "Standalone Keithley 4200A research test control workspace",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "identify": "node cli/identify.cjs",
    "serve": "node tools/prepare-dkds-plot-vendor.cjs && node src/server.cjs",
    "start": "node tools/prepare-dkds-plot-vendor.cjs && electron .",
    "dist:win": "node tools/prepare-dkds-plot-vendor.cjs && node tools/generate-app-icons.cjs && electron-builder --win nsis portable",
    "plugin:build": "node tools/build-dkds-plugin.cjs",
    "icons:build": "node tools/generate-app-icons.cjs",
    "prepare:plot-vendor": "node tools/prepare-dkds-plot-vendor.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "studio.dk.test",
    "productName": "DK Test Studio",
    "files": [
      "desktop/**",
      "src/**",
      "web/**",
      "package.json",
      "README.md",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "DK Test Studio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DK-Test-Studio-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "DK-Test-Studio-Portable-${version}-${arch}.${ext}"
    },
    "extraMetadata": {
      "description": "DK Test Studio · Keithley 4200A scientific measurement"
    }
  },
  "dependencies": {
    "d3": "7.9.0"
  }
}
